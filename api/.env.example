APP_NAME=BuildBass
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origem(ns) do front (web/), separadas por vírgula, liberadas no CORS.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Aponte para um MySQL vazio e, a seguir, rode `php artisan migrate` e
# `php artisan db:seed --class=DriverSeeder` (catálogo de drivers). Isso é feito por quem mantém o
# servidor; os testes (Pest) usam SQLite em memória e não tocam neste banco.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buildbass
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Envio de drivers. O captcha invisível fica desligado em desenvolvimento; em
# produção use TURNSTILE_ENABLED=true e o segredo do painel do Cloudflare.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=

# Leitura de manual por IA. Exige poppler-utils (pdftotext e pdfinfo) no servidor e
# upload_max_filesize/post_max_size >= 12M no PHP. Em produção use CACHE_STORE=database ou redis.
MANUAL_EXTRACTION_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# deny (padrão): só provedores que não guardam o texto. Modelos gratuitos exigem allow.
OPENROUTER_DATA_COLLECTION=deny
MANUAL_EXTRACTION_HOURLY_LIMIT=3
MANUAL_EXTRACTION_DAILY_CAP=200
PDFTOTEXT_BIN=pdftotext
PDFINFO_BIN=pdfinfo

# Auditoria do painel. Eventos mais antigos que isso são apagados por `audit:prune`,
# agendado diariamente (precisa do cron `* * * * * php artisan schedule:run`).
AUDIT_RETENTION_DAYS=180

# Imagens de driver. Exigem a extensão GD com WebP, `php artisan storage:link` e
# upload_max_filesize/post_max_size >= 6M no PHP. Os arquivos ficam em storage/app/public/driver-images
# (nomes UUID que nunca mudam: use cache longo nessa pasta no servidor web).

# Fuso em que o painel mostra datas e horas (o banco segue em UTC).
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

# Bloqueio automático de IP: ABUSE_MAX_STRIKES envios suspeitos em ABUSE_WINDOW_MINUTES
# bloqueiam o IP por ABUSE_BLOCK_MINUTES.
ABUSE_MAX_STRIKES=10
ABUSE_WINDOW_MINUTES=60
ABUSE_BLOCK_MINUTES=360
